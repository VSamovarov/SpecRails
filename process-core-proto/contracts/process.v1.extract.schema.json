{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://specrails.local/contracts/process.v1.extract.schema.json",
  "title": "ProcessProposalV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["entry", "lanes", "steps"],
  "properties": {
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "lane"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "lane": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "next": {
            "type": ["string", "null"],
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "branches": {
            "type": ["array", "null"],
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["when", "to"],
              "properties": {
                "when": {
                  "type": "string",
                  "minLength": 1
                },
                "to": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z][a-z0-9_]*$"
                }
              }
            }
          }
        },
        "allOf": [
          {
            "not": {
              "properties": {
                "next": {
                  "type": "string"
                },
                "branches": {
                  "type": "array"
                }
              },
              "required": ["next", "branches"]
            }
          }
        ]
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
