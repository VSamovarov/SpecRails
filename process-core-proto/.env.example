# AI Provider Configuration
# Раскомментируй и заполни ключ для нужного провайдера

# Google Gemini (рекомендуется для начала)
# Получить: https://aistudio.google.com/app/apikey
# Документация: docs/ai-providers/gemini.md
# GEMINI_API_KEY=AIzaSy...your_key_here

# Groq (очень быстро, бесплатно)
# Получить: https://console.groq.com/keys
# Документация: docs/ai-providers/groq.md
# GROQ_API_KEY=gsk_...your_key_here

# OpenAI (лучшее качество, платно)
# Получить: https://platform.openai.com/api-keys
# Документация: docs/ai-providers/openai.md
# OPENAI_API_KEY=sk-proj-...your_key_here
